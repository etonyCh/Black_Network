# Profil AppArmor — netsentinel-interceptd (Intercept1)

#include <tunables/global>

/usr/libexec/netsentinel/netsentinel-interceptd {
  #include <abstractions/base>

  capability net_raw,
  capability net_admin,

  network inet raw,
  network packet raw,

  /usr/libexec/netsentinel/netsentinel-interceptd mr,

  # Accès au socket D-Bus système & proc
  /run/dbus/system_bus_socket rw,
  /var/run/dbus/system_bus_socket rw,
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/stat r,
  @{PROC}/sys/kernel/ngroups_max r,

  owner /etc/netsentinel.env r,

  /var/log/netsentinel/intercept-audit.log a,

  #include <abstractions/dbus-strict>
  dbus (send, receive) bus=system,

  deny /home/** rwx,
  deny /root/** rwx,
  deny /etc/shadow r,
}
