# Profil AppArmor — netsentinel-discoverd (Discover1)
# Besoin réel : ouvrir un socket datalink (CAP_NET_RAW) pour émettre/recevoir
# des trames ARP. Aucun accès disque en écriture, aucun exec externe.

#include <tunables/global>

/usr/libexec/netsentinel/netsentinel-discoverd flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  capability net_raw,

  network inet raw,
  network inet dgram,
  network packet raw,

  /usr/libexec/netsentinel/netsentinel-discoverd mr,

  # Accès au socket D-Bus système & proc (chemins absolus et déconnectés)
  /{,var/}run/dbus/system_bus_socket rw,
  run/dbus/system_bus_socket rw,
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/stat r,
  @{PROC}/sys/kernel/ngroups_max r,
  proc/@{pid}/cgroup r,
  proc/@{pid}/stat r,

  # Lecture SEULE données statiques critiques (réseau système + conf)
  /etc/resolv.conf r,
  /sys/class/net/** r,

  # Données vulnérabilités + PQC
  /usr/share/netsentinel/data/vuln_database.json r,
  /usr/share/netsentinel/data/pqc_nist_reference.json r,
  /usr/share/netsentinel/data/checksums.sha256 r,

  # D-Bus système
  #include <abstractions/dbus-strict>
  dbus (send, receive) bus=system,

  # Tout le reste est refusé par défaut
  deny /home/** rwx,
  deny /root/** rwx,
  deny /etc/shadow r,
  deny /etc/passwd w,
}
