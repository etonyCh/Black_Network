# Profil AppArmor — netsentinel-captured (Capture1)

#include <tunables/global>

/usr/libexec/netsentinel/netsentinel-captured flags=(attach_disconnected) {
  #include <abstractions/base>

  capability bpf,
  capability net_admin,
  capability perfmon,
  capability sys_resource,

  network inet raw,
  network packet raw,

  /usr/libexec/netsentinel/netsentinel-captured mr,

  # Accès au socket D-Bus système & proc (chemins absolus et déconnectés)
  /{,var/}run/dbus/system_bus_socket rw,
  /**/run/dbus/system_bus_socket rw,
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/stat r,
  @{PROC}/sys/kernel/ngroups_max r,
  /**/cgroup r,

  # Programme eBPF embarqué
  /usr/libexec/netsentinel/*.o r,

  # Données statiques critiques — LECTURE SEULE
  /usr/share/netsentinel/data/vuln_database.json r,
  /usr/share/netsentinel/data/pqc_nist_reference.json r,
  /usr/share/netsentinel/data/checksums.sha256 r,

  # Point de montage bpffs
  /sys/fs/bpf/netsentinel/** rw,
  /sys/kernel/debug/tracing/** r,

  # Exports pcap
  /var/lib/netsentinel/captures/ rw,
  /var/lib/netsentinel/captures/** rw,

  #include <abstractions/dbus-strict>
  dbus (send, receive) bus=system,

  deny /home/** rwx,
  deny /root/** rwx,
}
