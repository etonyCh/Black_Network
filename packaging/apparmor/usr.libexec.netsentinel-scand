# Profil AppArmor — netsentinel-scand (Scan1)

#include <tunables/global>

/usr/libexec/netsentinel/netsentinel-scand flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  network inet stream,
  network inet6 stream,
  network inet dgram,

  /usr/libexec/netsentinel/netsentinel-scand mr,

  # Accès au socket D-Bus système & proc (chemins absolus et déconnectés)
  /{,var/}run/dbus/system_bus_socket rw,
  /**/run/dbus/system_bus_socket rw,
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/stat r,
  @{PROC}/sys/kernel/ngroups_max r,
  /**/cgroup r,

  # Données statiques critiques — LECTURE SEULE
  /usr/share/netsentinel/data/vuln_database.json r,
  /usr/share/netsentinel/data/pqc_nist_reference.json r,
  /usr/share/netsentinel/data/checksums.sha256 r,

  # Exécution des scanners externes en enfants directs uniquement
  /usr/bin/nmap         Cx -> nmap,
  /usr/bin/nuclei       Cx -> nuclei,
  /usr/local/bin/nuclei Cx -> nuclei,

  /var/lib/netsentinel/scans/ rw,
  /var/lib/netsentinel/scans/** rw,

  # Templates Nuclei système
  /usr/share/nuclei-templates/ r,
  /usr/share/nuclei-templates/** r,

  #include <abstractions/dbus-strict>
  dbus (send, receive) bus=system,
  dbus (bind) bus=system name=org.netsentinel.Scan1,

  deny capability net_raw,
  deny capability sys_admin,
  deny /home/** rwx,
  deny /root/** rwx,
}

profile nmap flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  network inet stream,
  network inet6 stream,
  /usr/bin/nmap mr,
  /tmp/** rw,
  deny capability net_raw,
}

profile nuclei flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  network inet stream,
  network inet6 stream,
  network inet dgram,

  /usr/bin/nuclei       mr,
  /usr/local/bin/nuclei mr,

  /etc/ssl/** r,
  /etc/ca-certificates/** r,

  /usr/share/nuclei-templates/ r,
  /usr/share/nuclei-templates/** r,

  /tmp/** rw,
}
