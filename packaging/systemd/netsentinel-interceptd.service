[Unit]
Description=NetSentinel — service d'interception ARP MitM (org.netsentinel.Intercept1)
Documentation=man:netsentinel-interceptd(8)
After=network.target dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.netsentinel.Intercept1
ExecStart=/usr/libexec/netsentinel/netsentinel-interceptd
Restart=on-failure
RestartSec=2

EnvironmentFile=-/etc/netsentinel.env

User=netsentinel-intercept
Group=netsentinel
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes

# --- Création automatique des dossiers système ---
StateDirectory=netsentinel
LogsDirectory=netsentinel
RuntimeDirectory=netsentinel

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes

ReadWritePaths=-/var/log/netsentinel

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
