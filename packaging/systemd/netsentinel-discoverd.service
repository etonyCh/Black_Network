[Unit]
Description=NetSentinel — service de découverte réseau (Discover1)
Documentation=man:netsentinel-discoverd(8)
After=network.target dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.netsentinel.Discover1
ExecStart=/usr/libexec/netsentinel/netsentinel-discoverd
Restart=on-failure
RestartSec=2

# --- Réduction des privilèges ---
User=netsentinel-discover
Group=netsentinel
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
NoNewPrivileges=yes

# --- Création automatique des dossiers système ---
StateDirectory=netsentinel
LogsDirectory=netsentinel
RuntimeDirectory=netsentinel

# --- Sandboxing filesystem/kernel ---
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# --- Réseau : AF_PACKET requis pour sockets bruts ARP ---
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET

# --- Filtrage syscall (liste blanche) ---
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
