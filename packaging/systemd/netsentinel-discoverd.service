[Unit]
Description=NetSentinel — service de découverte réseau (Discover1)
Documentation=man:netsentinel-discoverd(8)
After=network.target dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.netsentinel.Discover1
ExecStart=/usr/libexec/netsentinel/netsentinel-discoverd
Restart=on-failure
RestartSec=2

# --- Réduction des privilèges ---
# Pas de root : seulement CAP_NET_RAW, retiré du bounding set après usage
# initial n'est pas nécessaire ici car le process en a besoin en continu
# pour émettre/recevoir des trames ARP pendant toute sa durée de vie.
User=netsentinel-discover
Group=netsentinel
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
NoNewPrivileges=yes

# --- Sandboxing filesystem/kernel ---
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# --- Réseau : seul ce service a besoin d'AF_PACKET ---
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET

# --- Filtrage syscall (liste blanche) ---
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
